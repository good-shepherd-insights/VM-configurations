# =============================================================================
# AI Tools — Master Keys File
# =============================================================================
# Copy this file to keys.env and fill in your values.
#   cp keys.env.example keys.env
#   chmod 600 keys.env
#
# The install script (scripts/install-all.sh) reads keys.env and automatically
# populates every tool config. Only fill in keys for tools you use — leave the
# rest blank and the script will skip them.
#
# NEVER commit keys.env to git. It is excluded by .gitignore.
# =============================================================================

# ---- Claude Code ----
ANTHROPIC_API_KEY=
# If using a custom endpoint (e.g. Ollama), set these instead:
CLAUDE_CUSTOM_BASE_URL=
CLAUDE_CUSTOM_AUTH_TOKEN=

# ---- OpenAI Codex CLI ----
OPENAI_API_KEY=

# ---- GitHub Copilot CLI ----
# Auth is interactive via `copilot auth`. No key needed here.

# ---- Google Gemini CLI ----
GEMINI_API_KEY=
# Or use OAuth (handled on first run). Leave blank for OAuth.

# ---- Ollama ----
# Local Ollama needs no key. For Ollama Cloud:
OLLAMA_CLOUD_API_KEY=

# ---- Free Claude Code (FCC) ----
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
WAFER_API_KEY=
OPENCODE_API_KEY=
ZAI_API_KEY=
FIREWORKS_API_KEY=
GEMINI_API_KEY_FCC=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Local providers (leave as-is if not used)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
OLLAMA_BASE_URL=http://localhost:11434
# Default model route
FCC_DEFAULT_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
# Anthropic auth token for FCC server
FCC_ANTHROPIC_AUTH_TOKEN=
# Discord integration
FCC_DISCORD_BOT_TOKEN=
# Telegram integration
FCC_TELEGRAM_BOT_TOKEN=
# HuggingFace (for voice/whisper)
HF_TOKEN=

# ---- Kimi CLI ----
KIMI_CLI_API_KEY=

# ---- OpenCode ----
# Uses OPENCODE_API_KEY (shared with FCC above) or per-provider keys.

# ---- Cursor Agent ----
# Auth is handled by Cursor account login. No key needed here.

# ---- Multica ----
MULTICA_WORKSPACE_ID=
MULTICA_TOKEN=

# ---- OneCLI ----
ONECLI_POSTGRES_USER=onecli
ONECLI_POSTGRES_PASSWORD=onecli
ONECLI_POSTGRES_DB=onecli
ONECLI_NEXTAUTH_SECRET=
ONECLI_BIND_HOST=127.0.0.1
ONECLI_APP_PORT=10254
ONECLI_GATEWAY_PORT=10255

# ---- NanoClaw v2 ----
NANOCLAW_ONECLI_URL=http://127.0.0.1:10254
NANOCLAW_TZ=UTC

# ---- Hermes Agent ----
# Primary provider
HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_MODEL=
# OpenRouter
OPENROUTER_API_KEY_HERMES=
# Google Gemini
GOOGLE_API_KEY=
# Ollama Cloud
OLLAMA_API_KEY=
# z.ai / GLM
GLM_API_KEY=
# Kimi / Moonshot
KIMI_API_KEY_HERMES=
# Arcee AI
ARCEEAI_API_KEY=
# MiniMax
MINIMAX_API_KEY=
# HuggingFace
HF_TOKEN_HERMES=
# OpenCode Zen/Go
OPENCODE_ZEN_API_KEY=
OPENCODE_GO_API_KEY=
# Telegram gateway
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_ALLOWED_USERS=
# Discord gateway
HERMES_DISCORD_BOT_TOKEN=
HERMES_DISCORD_ALLOWED_CHANNELS=
# Slack gateway
HERMES_SLACK_BOT_TOKEN=
HERMES_SLACK_APP_TOKEN=
# Browser tools
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Web search
EXA_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=
# Image generation
FAL_KEY=
# Groq (STT)
GROQ_API_KEY_HERMES=
# GitHub (skills hub)
GITHUB_TOKEN=